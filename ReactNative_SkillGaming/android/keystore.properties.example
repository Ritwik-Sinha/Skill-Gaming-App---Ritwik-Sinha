# Copy this file to keystore.properties and replace the placeholder passwords.
# Never commit keystore.properties or the upload keystore.
SKILLGAMING_UPLOAD_STORE_FILE=app/skillgaming-upload.keystore
SKILLGAMING_UPLOAD_STORE_PASSWORD=replace-with-a-secure-password
SKILLGAMING_UPLOAD_KEY_ALIAS=skillgaming-upload
SKILLGAMING_UPLOAD_KEY_PASSWORD=replace-with-a-secure-password
SKILLGAMING_UPLOAD_STORE_TYPE=PKCS12
